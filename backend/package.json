{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx watch index.ts",
    "create-admin": "node dist/create-admin.js",
    "seed": "npx tsx prisma/seed.ts",
    "db:adopt": "node scripts/adopt-database.mjs",
    "db:deploy": "prisma migrate deploy && npm run db:check",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:load": "node scripts/run-load-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
