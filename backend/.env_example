# Konfigurasi Database PostgreSQL (Cloud SQL via PgBouncer jika di GCP)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Pool PostgreSQL per proses. APP_WORKERS diisi otomatis oleh konfigurasi PM2.
DB_POOL_MAX=5
DB_CONNECTION_BUDGET=40
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=16000

# Konfigurasi Server Node.js
PORT=3001

# Wajib: secret acak minimal 32 karakter; buat dengan openssl rand -hex 32
JWT_SECRET=

# Opsional: secret stabil minimal 32 karakter untuk enkripsi kartu login siswa.
# Jika kosong, menggunakan JWT_SECRET. Jangan ganti key yang digunakan tanpa migrasi kredensial.
LOGIN_CARD_SECRET=

# Konfigurasi Penyimpanan Gambar
# Pilih "LOCAL" untuk disk atau "GCP" untuk Cloud Storage
STORAGE_PROVIDER="LOCAL"

# Konfigurasi Google Cloud Storage (Opsional, jika STORAGE_PROVIDER="GCP")
# GCP_BUCKET_NAME="nama-bucket-gcp-anda"
# GCP_PROJECT_ID="id-project-gcp-anda"
# GCP_KEY_FILE_PATH="./path/ke/file-service-account-anda.json"

# Konfigurasi Redis / Memorystore untuk Caching (Opsional)
# Ubah USE_REDIS ke "true" untuk mengaktifkan Redis Cache
USE_REDIS="false"
# REDIS_URL="redis://username:password@host:port"
